# Copiá este archivo como ".env" en la carpeta repos/ (junto a las carpetas de los 3 repos) y completá los valores.
#
# El .env NO se sube a Git (está en .gitignore): contiene tokens. No lo compartas ni lo pegues en chats.
# Formato: una variable por línea, CLAVE=valor. Sin comillas ni comentarios al final de la línea.

# ── GitHub: UN solo token para todos los repos de la organización diegodevopsorgs ────────────────
# Se crea en https://github.com/settings/personal-access-tokens/new (token "fine-grained"):
#   Resource owner:        diegodevopsorgs
#   Repository access:     All repositories   (así las apps futuras no piden un token nuevo)
#   Repository permissions: Contents → Read and write
# Empieza con github_pat_
GH_TOKEN=

# ── Docker Hub ───────────────────────────────────────────────────────────────────────────────────
# Tu usuario de Docker Hub
DOCKERHUB_USER=diego1986

# Access token de Docker Hub con permiso Read & Write (empieza con dckr_pat_).
# Se crea en Docker Hub: Account settings → Personal access tokens.
# OJO: no es el token de GitHub (ese empieza con github_pat_).
DOCKERHUB_TOKEN=

# ── Opcional: recursos de minikube (si no se definen, usa los valores por defecto de minikube) ───
# MINIKUBE_CPUS=4
# MINIKUBE_MEMORY=6144
